# weather-reminder-0519 配置
# 复制此文件为 config.env 并填入密钥

# OpenWeatherMap API Key（必填）
# 注册：https://home.openweathermap.org/api_keys
OWM_KEY=YOUR_OPENWEATHERMAP_KEY

# ServerChan SendKey（必填）
# 注册：https://sct.ftqq.com
SCT_KEY=YOUR_SERVERCHAN_KEY

# 城市名称（可选，不填则用 IP 定位）
# 推荐填写，GitHub Actions 运行时会用此值
CITY=南京
